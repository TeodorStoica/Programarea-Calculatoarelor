def sortare_insertie(n, zile):
    for i in range(1, n):
        if zile[i] > zile[i-1]:
            x = zile[i]
            j = 0
            ok = False
            poz =i
            
            while j > i and ok == False:
                if zile[i] < zile[j]:
                    ok = True 
                    poz = j
                j += 1
            for j in range(i, poz, -1):
                zile[j] = zile[j-1]
            zile[poz] = x
            
    return zile
