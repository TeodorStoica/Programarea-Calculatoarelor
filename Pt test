def insereazaDupaValoare(v, valoare, nou): 
    i=0
    while i<len(v):
        if v[i]==valoare:
            v.append(0)
            for j in range(len(v)-1,i+1,-1):
                v[j]=v[j-1]
            v[i+1]=nou
        i+=1
    return(v)
