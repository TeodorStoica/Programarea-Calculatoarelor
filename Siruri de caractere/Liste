cod=str(input())
x=len(cod)
l=0
n=0
car=0
for c in cod:
    if c.isalpha():
        l+=1
    elif c.isdigit():
        n+=1
    else:
        car+=1
if n>=2 and l>=2 and x>=6 and car==0:
    print("codul este valid")
else:
    print("cod invalid")
